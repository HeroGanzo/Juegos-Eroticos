# Desarrollo: copia a .env.local. VPS: copia a /etc/juegos-eroticos/app.env.
# Valores de ejemplo: reemplaza la contraseña y nunca subas el archivo real a Git.
DATABASE_URL=postgresql://juegos:REEMPLAZA_LA_PASSWORD@127.0.0.1:5432/juegos_eroticos
# Para Postgres local déjalo sin definir (sin TLS por loopback).
# Para Postgres remoto con un certificado de confianza, activa la verificación:
# DATABASE_SSL=verify-full
# DB_POOL_MAX=10

# Solo para inicializar una BD nueva; no modifican usuarios que ya existen.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# En el servicio del VPS se exige una contraseña inicial de al menos 16 caracteres.
# REQUIRE_SECURE_ADMIN_BOOTSTRAP=true

# Opcional: solo si quieres seguir subiendo archivos nuevos a Vercel Blob.
# BLOB_READ_WRITE_TOKEN=
